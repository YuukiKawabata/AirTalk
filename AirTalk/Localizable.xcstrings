    "AirTalk does not tolerate objectionable content or abusive users. Harassment, threats, hate speech, sexual content involving minors, spam, impersonation, and any unlawful or harmful conduct are prohibited.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirTalk does not tolerate objectionable content or abusive users. Harassment, threats, hate speech, sexual content involving minors, spam, impersonation, and any unlawful or harmful conduct are prohibited."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirTalk does not tolerate objectionable content or abusive users. Harassment, threats, hate speech, sexual content involving minors, spam, impersonation, and any unlawful or harmful conduct are prohibited."
          }
        }
      }
    },
    "AirTalk is a peer-to-peer chat app. You are responsible for the messages and profile text you share with nearby users. Do not share content that violates these terms or another person's rights.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirTalk is a peer-to-peer chat app. You are responsible for the messages and profile text you share with nearby users. Do not share content that violates these terms or another person's rights."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirTalk is a peer-to-peer chat app. You are responsible for the messages and profile text you share with nearby users. Do not share content that violates these terms or another person's rights."
          }
        }
      }
    },
    "AirTalk はサーバーアカウントを作成せず、チャット履歴をサーバーに保存しません。プロフィールは端末内に保存され、相手と直接接続した場合にのみ相手の端末へ送信されます。設定画面からプロフィールとローカルデータを削除できます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirTalk does not create server accounts or store chat history on any server. Your profile is stored on your device and is sent to another device only when you connect directly. You can delete your profile and local data from the settings screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirTalk はサーバーアカウントを作成せず、チャット履歴をサーバーに保存しません。プロフィールは端末内に保存され、相手と直接接続した場合にのみ相手の端末へ送信されます。設定画面からプロフィールとローカルデータを削除できます。"
          }
        }
      }
    },
    "AirTalk 利用規約 / EULA": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirTalk Terms of Use / EULA"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirTalk 利用規約 / EULA"
          }
        }
      }
    },
    "AirTalk、ネット無しで繋がるの不思議ですね": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wild that AirTalk works without internet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirTalk、ネット無しで繋がるの不思議ですね"
          }
        }
      }
    },
    "AirTalkでつながるの不思議ですね": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Funny how AirTalk connects us, isn't it?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirTalkでつながるの不思議ですね"
          }
        }
      }
    },
    "AirTalkで話そう！インターネットなしで、近くの人とだけチャットできるアプリです。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's chat on AirTalk! It lets you chat with people nearby, no internet needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirTalkで話そう！インターネットなしで、近くの人とだけチャットできるアプリです。"
          }
        }
      }
    },
    "AirTalkは、同じアプリを入れた人が近くにいるとつながります。このQRコードを相手のカメラで読み取ってもらいましょう。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirTalk connects you with people nearby who also have the app. Ask your friend to scan this QR code with their camera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirTalkは、同じアプリを入れた人が近くにいるとつながります。このQRコードを相手のカメラで読み取ってもらいましょう。"
          }
        }
      }
    },
    "App StoreのAirTalkページへのQRコード": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QR code for AirTalk on the App Store"
