          }
        }
      }
    },
    "こんにちは！近くにいたので話しかけてみました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi! I saw you nearby and thought I'd say hello"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こんにちは！近くにいたので話しかけてみました"
          }
