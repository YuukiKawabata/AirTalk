          }
        }
      }
    },
    "購入情報を読み込めませんでした。時間をおいてもう一度お試しください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load purchase information. Please try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入情報を読み込めませんでした。時間をおいてもう一度お試しください。"
          }
        }
      }
    },
    "近くですれ違った参加者を記録し、会話のリクエストが届いたときにお知らせします。右上の歯車ボタンからいつでも変更できます。通知はiPhoneの設定アプリでもオフにできます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirTalk records participants you pass nearby and lets you know when a chat request arrives. You can change this anytime with the gear button at the top right. You can also turn off notifications in the iPhone Settings app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くですれ違った参加者を記録し、会話のリクエストが届いたときにお知らせします。右上の歯車ボタンからいつでも変更できます。通知はiPhoneの設定アプリでもオフにできます。"
          }
        }
      }
    },
    "近くで出会った人と、お互いが望んだときだけオンラインで話せます。今までのオフラインチャットは、そのまま無料です。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くで出会った人と、お互いが望んだときだけオンラインで話せます。今までのオフラインチャットは、そのまま無料です。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk online with someone you crossed paths with, only when you both agree. Your existing offline chat stays free."
          }
        }
      }
    },
    "近くで話す": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くで話す"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby chat"
          }
        }
      }
    },
    "近くにAirTalkユーザーがいません": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No AirTalk users nearby"
