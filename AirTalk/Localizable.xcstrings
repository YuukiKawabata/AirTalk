    "%@ さんがチャットを開始したいです": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wants to chat with you"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんがチャットを開始したいです"
          }
        }
      }
    },
    "%@ さんにリクエストが拒否されました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ declined your request"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんにリクエストが拒否されました"
          }
        }
