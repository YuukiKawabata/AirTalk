    },
    "%@ さんがチャットを開始したいです": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wants to chat with you"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんがチャットを開始したいです"
          }
        }
      }
    },
    "%@ さんにリクエストが拒否されました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ declined your request"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんにリクエストが拒否されました"
          }
        }
      }
    },
    "%@の無料トライアル後、%@ごとに自動更新": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ free trial, then renews every %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の無料トライアル後、%@ごとに自動更新"
          }
