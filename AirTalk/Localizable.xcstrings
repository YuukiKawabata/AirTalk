    "ONLINE_REQUEST_NOTIFICATION": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have a new AirTalk request. Open the app to review it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirTalkに新しいリクエストがあります。アプリで確認してください。"
          }
        }
      }
    },
    "Questions, abuse reports, and support requests can be sent to %@. Support information is available at %@. Terms of Use: %@. Privacy Policy: %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions, abuse reports, and support requests can be sent to %1$@. Support information is available at %2$@. Terms of Use: %3$@. Privacy Policy: %4$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions, abuse reports, and support requests can be sent to %@. Support information is available at %@. Terms of Use: %@. Privacy Policy: %@."
          }
        }
      }
    },
    "Wi-FiとBluetoothで、半径50m以内のAirTalkユーザーと直接つながります。インターネットもアカウントも不要です。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect directly with AirTalk users within about 50 m (160 ft) over Wi-Fi and Bluetooth. No internet or account needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-FiとBluetoothで、半径50m以内のAirTalkユーザーと直接つながります。インターネットもアカウントも不要です。"
          }
        }
      }
    },
    "「設定」でローカルネットワークと\nBluetoothの許可をオンにしてください": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Local Network and\nBluetooth access in Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」でローカルネットワークと\nBluetoothの許可をオンにしてください"
          }
        }
      }
    },
    "あとで": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
