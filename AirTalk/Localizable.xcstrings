    "購入の復元に失敗しました。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't restore purchases."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入の復元に失敗しました。"
          }
        }
      }
    },
    "購入は承認待ちです。承認後にAirTalk Plusが自動で有効になります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase is pending approval. AirTalk Plus will activate automatically once approved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。承認後にAirTalk Plusが自動で有効になります。"
          }
        }
      }
    },
    "購入を完了できませんでした。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't complete the purchase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を完了できませんでした。"
          }
        }
      }
    },
    "購入を復元": {
      "localizations": {
        "en": {
