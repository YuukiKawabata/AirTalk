{
  "name": "airtalk-online-pilot",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "MODE": "production",
    "ONLINE_ENABLED": "true",
    "APPLE_CLIENT_ID": "com.yuuki.AirTalk",
  },
  "durable_objects": {
    "bindings": [{ "name": "PILOT", "class_name": "PilotHub" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PilotHub"] }],
}
